{
  "name": "noctan",
  "productName": "Noctan",
  "version": "1.0.22",
  "private": true,
  "type": "module",
  "main": "desktop.mjs",
  "bin": {
    "noctan-mcp": "bridge.mjs"
  },
  "scripts": {
    "start": "node server.mjs",
    "desktop": "electron .",
    "mcp": "node bridge.mjs",
    "check": "node --check server.mjs && node --check desktop.mjs && node --check public/app.js && node --test tests/*.test.mjs",
    "dist:win": "electron-builder --win nsis"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.302",
    "@huggingface/transformers": "^4.3.1",
    "@modelcontextprotocol/sdk": "^1.32.1",
    "electron-updater": "^6.8.9",
    "openai": "^7.38.0",
    "sherpa-onnx-node": "^1.13.8",
    "ws": "^8.22.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "electron": "^44.9.0",
    "electron-builder": "^26.15.3"
  },
  "build": {
    "appId": "app.noctan.desktop",
    "productName": "Noctan",
    "asar": true,
    "files": [
      "desktop.mjs",
      "bridge.mjs",
      "pc-controller-manager.mjs",
      "openai-provider.mjs",
      "mcp-client.mjs",
      "tunnel-manager.mjs",
      "server.mjs",
      "public/**/*",
      "data/.gitkeep",
      "package.json",
      "node_modules/**/*",
      "realtime-stt-worker.mjs",
      "secure-key.mjs",
      "preload.cjs",
      "mobile-gateway.mjs"
    ],
    "directories": {
      "output": "dist"
    },
    "win": {
      "icon": "public/noctan-mark.png",
      "target": [
        "nsis"
      ],
      "artifactName": "Noctan-Setup-${version}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    },
    "asarUnpack": [
      "node_modules/@anthropic-ai/claude-agent-sdk-win32-x64/**/*"
    ],
    "publish": [
      {
        "provider": "github",
        "owner": "yanoliveira16",
        "repo": "Noctan",
        "releaseType": "release"
      }
    ]
  },
  "engines": {
    "node": ">=20"
  }
}
