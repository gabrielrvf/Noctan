{
  "name": "noctan",
  "productName": "Noctan",
  "version": "1.0.48",
  "private": true,
  "type": "module",
  "main": "desktop.mjs",
  "bin": {
    "noctan-mcp": "bridge.mjs"
  },
  "scripts": {
    "start": "node server.mjs",
    "desktop": "electron .",
    "mcp": "node bridge.mjs",
    "check": "node --check server.mjs && node --check desktop.mjs && node --check public/app.js && node --test tests/*.test.mjs",
    "tunnel:fetch": "node scripts/fetch-tunnel-client.mjs",
    "dist:win": "npm run tunnel:fetch && electron-builder --win nsis",
    "dist:mac": "npm run tunnel:fetch && electron-builder --mac dmg zip"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.302",
    "@huggingface/transformers": "^4.3.1",
    "@modelcontextprotocol/sdk": "^1.32.1",
    "electron-updater": "^6.8.9",
    "mcp-chatgpt-full-pc-dev": "https://github.com/tgzx/MCP-ChatGPT/archive/02ad6e0bcb343c3fc2dd34cbccc9b7962e301992.tar.gz",
    "openai": "^7.38.0",
    "sherpa-onnx-node": "^1.13.8",
    "ws": "^8.22.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "electron": "^44.9.0",
    "electron-builder": "^26.15.3"
  },
  "build": {
    "appId": "app.noctan.desktop",
    "productName": "Noctan",
    "asar": true,
    "files": [
      "desktop.mjs",
      "bridge.mjs",
      "noctan-mcp.mjs",
      "external-handoff.mjs",
      "pc-controller-manager.mjs",
      "embedded-pc-controller.mjs",
      "openai-provider.mjs",
      "mcp-client.mjs",
      "tunnel-manager.mjs",
      "noctan-tunnel-profile.mjs",
      "generated-images.mjs",
      "server.mjs",
      "public/**/*",
      "data/.gitkeep",
      "package.json",
      "node_modules/**/*",
      "realtime-stt-worker.mjs",
      "secure-key.mjs",
      "preload.cjs",
      "mobile-gateway.mjs"
    ],
    "directories": {
      "output": "dist"
    },
    "extraResources": [
      {
        "from": "vendor/tunnel-client",
        "to": "tunnel-client",
        "filter": ["**/*", "!**/*.zip"]
      }
    ],
    "win": {
      "icon": "public/noctan-mark.png",
      "target": [
        "nsis"
      ],
      "artifactName": "Noctan-Setup-${version}.${ext}"
    },
    "mac": {
      "icon": "build/icon.icns",
      "category": "public.app-category.productivity",
      "hardenedRuntime": true,
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.plist",
      "target": [
        "dmg",
        "zip"
      ],
      "artifactName": "Noctan-${version}-mac-${arch}.${ext}",
      "extendInfo": {
        "NSMicrophoneUsageDescription": "O Noctan usa o microfone para ditado por voz."
      }
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "include": "build/installer.nsh"
    },
    "asarUnpack": [
      "node_modules/@anthropic-ai/claude-agent-sdk-win32-x64/**/*",
      "node_modules/@anthropic-ai/claude-agent-sdk-darwin-*/**/*",
      "node_modules/mcp-chatgpt-full-pc-dev/**/*",
      "node_modules/playwright/**/*",
      "node_modules/playwright-core/**/*"
    ],
    "publish": [
      {
        "provider": "github",
        "owner": "yanoliveira16",
        "repo": "Noctan",
        "releaseType": "release"
      }
    ]
  },
  "engines": {
    "node": ">=20"
  }
}
